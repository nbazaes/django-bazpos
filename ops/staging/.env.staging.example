# Plantilla del .env que deploy-stack.sh genera en ops/staging/.env.generated
# (NO versionar: contiene secretos). Los valores aquí son de ejemplo.

DJANGO_SECRET_KEY=generate-con-openssl-rand-base64-50
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=192.168.150.160,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

DB_NAME=bazpos_db
DB_USER=bazpos
DB_PASSWORD=generate-con-openssl-rand-hex-16
DB_HOST=db
DB_PORT=3306

STORE_NAME=EUROCAS
VITE_STORE_NAME=EUROCAS

ADMIN_USER=admin
ADMIN_EMAIL=admin@staging.local
ADMIN_PASS=generate-con-openssl-rand-hex-16

MYSQL_ROOT_PASSWORD=generate-con-openssl-rand-hex-16
MYSQL_DATABASE=bazpos_db
MYSQL_USER=bazpos
MYSQL_PASSWORD=generate-con-openssl-rand-hex-16

# Imágenes exactas de producción (compose las interpola desde este .env)
APP_IMAGE=ghcr.io/nbazaes/django-bazpos:app-<sha-de-main>
NGINX_IMAGE=ghcr.io/nbazaes/django-bazpos:nginx-<sha-de-main>