# Secretos del backup BazPOS (restic -> Backblaze B2)
#
# 1) Copiar este archivo al VPS como /etc/restic/bazpos.env
# 2) Rellenar valores reales
# 3) Permisos: chmod 600, propietario root (nunca versionar este archivo real)
#
# Sin comillas en los valores (el script los lee con whitelist, no hace source).

# Repositorio restic. Reemplaza <bucket> y la región por las de tu bucket B2.
RESTIC_REPOSITORY=s3:https://s3.us-west-004.backblazeb2.com/bazpos-backups

# Frase de paso para encriptar el repo. Genera algo largo y guárdala en tu
# password manager: sin ella no hay forma de recuperar los backups.
#   openssl rand -base64 32
RESTIC_PASSWORD=genera-una-frase-segura-y-guardala-en-tu-password-manager

# App Key de B2 con scope SOLO a este bucket (lectura+escritura, no owner).
B2_ACCOUNT_ID=keyIdDelAppKey
B2_ACCOUNT_KEY=applicationKeyDelAppKey