# ==============================================================================
# BazPOS - Local Development Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual values for local dev.
# Never commit .env to git (already in .gitignore).
# For Docker production deployment, use .env.production.example instead.

# Django Settings
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
# Admin "Ver el sitio" destination; change to your frontend LAN URL if needed.
FRONTEND_URL=http://localhost:5173/
# Add your LAN IP (e.g. 192.168.1.50) for access from other PCs on the network
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS - frontend origins allowed to call the API
# Add frontend dev server origins (local + LAN IPs) and production origins
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Database Configuration
# Keep DB_HOST as 127.0.0.1 — never expose MySQL to the network
# ------------------------------------------------------------------------------
DB_NAME=bazpos_db
DB_USER=root
DB_PASSWORD=your-mysql-password-here
DB_HOST=127.0.0.1
DB_PORT=3306

# Store name displayed in the UI. Read at runtime from /api/store-name/.
# Install-time setting: change it in .env, not in the Configuración UI.
STORE_NAME=BAZPOS

# Locale used for number/date formatting (e.g. es-CL, en-US). Install-time.
STORE_LOCALE=es-CL

# Support Tickets & Resend Email Service
# ------------------------------------------------------------------------------
# API key from https://resend.com (required to send tickets, including locally)
RESEND_API_KEY=
# Sender email address configured in Resend (default: onboarding@resend.dev)
RESEND_FROM_EMAIL="BazPos <onboarding@resend.dev>"
# Recipient email where support tickets and suggestions will be delivered
SUPPORT_EMAIL=soporte@bazpos.com

# Invoice OCR: choose openrouter or gemini. Keys stay on the Django server.
BAZPOS_OCR_ENABLED=False
BAZPOS_OCR_PROVIDER=openrouter
# If omitted, OpenRouter can reuse BAZPOS_LLM_API_KEY from the server environment.
BAZPOS_OCR_OPENROUTER_API_KEY=
BAZPOS_OCR_GEMINI_API_KEY=
# Empty = google/gemini-2.5-flash (OpenRouter) or gemini-2.5-flash (Gemini).
BAZPOS_OCR_MODEL=
